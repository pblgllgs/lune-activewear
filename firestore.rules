rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'pablogallegosgonzalez@gmail.com'
            || request.auth.token.email == 'admin@luneactivewear.cl');
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contenido editable del sitio: hero del inicio e imágenes de Nosotros.
    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bloqueo total del resto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
