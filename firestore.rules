rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.token.email == 'pablogallegosgonzalez@gmail.com'
            || request.auth.token.email == 'admin@luneactivewear.cl');
    }

    // Bloqueo total del resto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
