rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.get('email', '') == 'pablogallegosgonzalez@gmail.com'
            || request.auth.token.get('email', '') == 'admin@luneactivewear.cl');
    }

    // Correo de la sesión en minúsculas, sin errores si el token no lo trae.
    function ownerEmail() {
      return request.auth != null ? request.auth.token.get('email', '').lower() : '';
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Comentarios/reseñas por producto: la clienta crea (pendiente de aprobación)
      // y el admin modera (aprueba/elimina).
      match /reviews/{reviewId} {
        allow read: if resource.data.approved == true || isAdmin();
        allow create: if request.resource.data.approved == false
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1200
          && request.resource.data.productId == productId
          && (!('rating' in request.resource.data)
              || (request.resource.data.rating is int
                  && request.resource.data.rating >= 1
                  && request.resource.data.rating <= 5));
        allow update, delete: if isAdmin();
      }
    }

    // Contenido editable del sitio: hero del inicio e imágenes de Nosotros.
    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Guías/blog: artículos de contenido SEO. Lectura pública solo si están publicados.
    match /guides/{guideId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Proveedores, sus productos y el registro de compras (solo admin).
    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();

      match /purchases/{purchaseId} {
        allow read, write: if isAdmin();
      }
    }

    // Órdenes de compra: la clienta crea una orden pendiente desde el carrito;
    // el admin puede registrar ventas manuales (p. ej. WhatsApp) y gestionar todas.
    // Cada clienta puede leer solo sus pedidos (por UID o correo).
    match /orders/{orderId} {
      allow create: if
        (request.resource.data.status == 'pendiente'
          && request.resource.data.stockApplied == false
          && request.resource.data.code is string
          && request.resource.data.code.size() > 0
          && request.resource.data.code.size() <= 40
          && request.resource.data.customer is map
          && request.resource.data.customer.name is string
          && request.resource.data.customer.name.size() > 0
          && request.resource.data.customer.name.size() <= 120
          && request.resource.data.customer.phone is string
          && request.resource.data.customer.phone.size() >= 8
          && request.resource.data.customer.phone.size() <= 40
          && request.resource.data.customer.address is string
          && request.resource.data.customer.address.size() > 0
          && request.resource.data.customer.address.size() <= 300
          && request.resource.data.customer.city is string
          && request.resource.data.customer.city.size() > 0
          && request.resource.data.customer.city.size() <= 120
          && (!('customerEmail' in request.resource.data)
              || (request.resource.data.customerEmail is string
                  && request.resource.data.customerEmail.size() <= 254))
          // El UID solo puede ser el de la propia sesión (o vacío si es invitada).
          && (!('userId' in request.resource.data)
              || request.resource.data.userId == ''
              || (request.auth != null
                  && request.resource.data.userId == request.auth.uid))
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 50
          && request.resource.data.subtotal is number
          && request.resource.data.subtotal >= 0)
        || (isAdmin()
          && request.resource.data.status in ['pendiente', 'aprobada', 'rechazada', 'pagado', 'enviado']
          && request.resource.data.stockApplied is bool
          && request.resource.data.code is string
          && request.resource.data.code.size() > 0
          && request.resource.data.code.size() <= 40
          && request.resource.data.customer is map
          && request.resource.data.customer.name is string
          && request.resource.data.customer.name.size() > 0
          && request.resource.data.customer.phone is string
          && request.resource.data.customer.phone.size() >= 8
          && request.resource.data.customer.address is string
          && request.resource.data.customer.address.size() > 0
          && request.resource.data.customer.city is string
          && request.resource.data.customer.city.size() > 0
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 50
          && request.resource.data.subtotal is number
          && request.resource.data.subtotal >= 0);
      allow read: if isAdmin()
        || (request.auth != null
            && (resource.data.get('userId', '') == request.auth.uid
                || (ownerEmail() != ''
                    && resource.data.get('customerEmail', '') == ownerEmail())));
      allow update, delete: if isAdmin();
    }

    // Registro de auditoría: cada usuario autenticado crea sus propias entradas
    // (autor, acción y fecha del servidor). Solo el admin puede leerlas.
    // No se permite editar ni borrar para conservar el historial.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == ownerEmail()
        && request.resource.data.actorRole in ['admin', 'client']
        // Las clientas solo registran sus propias compras y comentarios.
        && (isAdmin()
            || request.resource.data.action in ['order.create', 'review.create'])
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80
        && request.resource.data.entity is string
        && request.resource.data.entity.size() > 0
        && request.resource.data.entity.size() <= 80
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 500
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // Bloqueo total del resto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
