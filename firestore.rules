rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'pablogallegosgonzalez@gmail.com'
            || request.auth.token.email == 'admin@luneactivewear.cl');
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Comentarios/reseñas por producto: la clienta crea (pendiente de aprobación)
      // y el admin modera (aprueba/elimina).
      match /reviews/{reviewId} {
        allow read: if resource.data.approved == true || isAdmin();
        allow create: if request.resource.data.approved == false
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1200
          && request.resource.data.productId == productId
          && (!('rating' in request.resource.data)
              || (request.resource.data.rating is int
                  && request.resource.data.rating >= 1
                  && request.resource.data.rating <= 5));
        allow update, delete: if isAdmin();
      }
    }

    // Contenido editable del sitio: hero del inicio e imágenes de Nosotros.
    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bloqueo total del resto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
