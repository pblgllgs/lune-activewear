# Firebase (opcional para ver la demo: sin configurar se usa el catálogo de ejemplo)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudflare R2 (worker desplegado en /worker)
VITE_R2_WORKER_URL=https://lune-activewear.tu-cuenta.workers.dev
VITE_UPLOAD_TOKEN=token-compartido-con-el-worker

# Super admin: puede administrar a los demás admins desde el panel.
# Por defecto: pablogallegosgonzalez@gmail.com
VITE_SUPER_ADMIN_EMAIL=pablogallegosgonzalez@gmail.com

# Emails admin adicionales (respaldo; los admins se gestionan desde el panel)
VITE_ADMIN_EMAILS=admin@luneactivewear.cl

# URL pública del sitio (canonical, Open Graph y sitemap)
VITE_SITE_URL=

# --- Variables del servidor (Pages Functions) -------------------------------
# No llevan prefijo VITE_ y NUNCA se exponen al navegador. En producción se
# cargan como secretos en Cloudflare Pages → Settings → Environment variables.

# Correo transaccional (Brevo por defecto; Resend como alternativa)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# RESEND_API_KEY=
MAIL_FROM=no-reply@lune-activewear.pages.dev
MAIL_FROM_NAME=LUNÉ Activewear
# MAIL_REPLY_TO=hola@luneactivewear.cl
# EMAIL_DRY_RUN=1

# Service account de Firebase (Firestore desde las Functions)
# Opción A: el JSON completo en una sola variable.
FIREBASE_SERVICE_ACCOUNT=
# Opción B: variables sueltas.
# FIREBASE_PROJECT_ID=lune-activewear
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# API key web de Firebase (para validar el ID token de los admins)
FIREBASE_API_KEY=

# Super admin en servidor (debe coincidir con VITE_SUPER_ADMIN_EMAIL)
SUPER_ADMIN_EMAIL=pablogallegosgonzalez@gmail.com

# Correos con permiso para enviar avisos y correos de estado (respaldo)
ADMIN_EMAILS=admin@luneactivewear.cl
