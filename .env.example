# Firebase (opcional para ver la demo: sin configurar se usa el catálogo de ejemplo)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudflare R2 (worker desplegado en /worker)
VITE_R2_WORKER_URL=https://lune-activewear.tu-cuenta.workers.dev
VITE_UPLOAD_TOKEN=token-compartido-con-el-worker

# Emails admin (deben coincidir con firestore.rules)
VITE_ADMIN_EMAILS=

# URL pública del sitio (canonical, Open Graph y sitemap)
VITE_SITE_URL=
